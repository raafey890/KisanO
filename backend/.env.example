# Application Config
ENVIRONMENT=development
APP_NAME="KisanO Backend"

# Security
SECRET_KEY=generate_a_secure_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
MONGODB_URL=mongodb://root:example@mongodb:27017/
MONGODB_DB_NAME=kisano_db

# Redis / Cache / Jobs
REDIS_URL=redis://redis:6379/0

# External Providers (Mocked for Dev)
STRIPE_API_KEY=sk_test_mock
AWS_S3_BUCKET=mock_bucket
