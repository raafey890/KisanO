# =============================================================================
# KisanO Backend — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file. Only commit this .env.example.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=production
APP_NAME="KisanO Backend"
DEBUG=false
WORKER_MODE=standalone
BACKGROUND_WORKERS_COUNT=3

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=generate_a_32_char_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_HOSTS=localhost,127.0.0.1  # Comma-separated list of allowed hosts
CORS_ORIGINS=http://localhost:5173  # Comma-separated, no trailing slash

# ---------------------------------------------------------------------------
# Database — MongoDB
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://root:example@mongodb:27017/
MONGODB_DB_NAME=kisano_db

# ---------------------------------------------------------------------------
# Cache & Queue — Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Retry & Job Settings (Phase 11)
# ---------------------------------------------------------------------------
MAX_JOB_RETRIES=3
RETRY_DELAY_SECONDS=5
BACKOFF_MULTIPLIER=2.0
EMAIL_TIMEOUT=30
SMS_TIMEOUT=15
FCM_TIMEOUT=10
MAX_CONCURRENT_EMAILS=5
MAX_CONCURRENT_SMS=10
MAX_CONCURRENT_PUSH=20
CLEANUP_INTERVAL_HOURS=24
ANALYTICS_REFRESH_HOURS=6
SESSION_EXPIRY_DAYS=30
WEBHOOK_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# SMTP — Email Provider
# ---------------------------------------------------------------------------
SMTP_HOST=                         # e.g. smtp.gmail.com or smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kisano.in
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Firebase — Push Notifications (FCM)
# ---------------------------------------------------------------------------
FIREBASE_CREDENTIALS_JSON_PATH=    # Absolute path to service-account.json

# ---------------------------------------------------------------------------
# Cloudinary — Media Storage
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# Razorpay — Payments
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---------------------------------------------------------------------------
# MSG91 — SMS / OTP
# ---------------------------------------------------------------------------
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=your_sender_id
MSG91_OTP_TEMPLATE_ID=your_template_id

# ---------------------------------------------------------------------------
# Google Gemini AI
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
DEFAULT_AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Monitoring (Prometheus/Grafana)
# ---------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090

# ---------------------------------------------------------------------------
# Backup Configuration
# ---------------------------------------------------------------------------
BACKUP_S3_BUCKET=                  # e.g. s3://kisano-backups/db/
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
